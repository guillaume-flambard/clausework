            {
              "fieldName": "owner",
              "fieldLabel": "Who is the named person responsible for this automation? We need one individual owner, not a team.",
              "fieldType": "text",
              "placeholder": "E.g., Jennifer Walsh, Head of Sales Development",
              "requiredField": true
            }
          ]
        },
        "options": {
          "formTitle": "Step 1: Owner",
          "formDescription": "We need one individual owner, not a team.",
          "buttonLabel": "Next",
          "appendAttribution": false
        }
