              "fieldLabel": "What specific event or condition starts this automation, and what single action follows? (Format: \"When X happens, then do Y.\")",
              "fieldType": "textarea",
              "placeholder": "Format: \"When X happens, then do Y.\"",
              "requiredField": true
            }
          ]
        },
        "options": {
          "formTitle": "Step 2: Trigger",
          "formDescription": "Express the automation as a single condition and action.",
          "buttonLabel": "Next",
          "appendAttribution": false
        }
      }
    },
