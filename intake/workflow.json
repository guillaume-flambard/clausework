    },
    {
      "id": "9509bbe7-2542-42ab-964c-4aa633ab2339",
      "name": "Check Owner",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.owner }}",
              "operator": {
                "type": "string",
                "operation": "isEmpty"
              }
            },
            {
              "leftValue": "={{ (function() { const owner = $json.owner || ''; const hasTeamWord = /team|equipe|équipe|service|department|dept|group|squad|everyone|all of us/i.test(owner); if (!hasTeamWord) return false; return !owner.includes(','); })() }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
